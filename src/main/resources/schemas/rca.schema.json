{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qa.local/schemas/rca.schema.json",
  "title": "RCA report (target/rca/rca.json)",
  "type": "object",
  "required": ["runId", "generatedAt", "failures", "groups", "entries"],
  "properties": {
    "runId": { "type": "string" },
    "generatedAt": { "type": "string" },
    "failures": { "type": "integer" },
    "groups": { "type": "integer" },
    "newFailures": { "type": "integer" },
    "byCategory": { "type": "object", "additionalProperties": { "type": "integer" } },
    "byOwner": { "type": "object", "additionalProperties": { "type": "integer" } },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["caseId", "endpoint", "category", "confidence", "signature", "summary", "probableCause", "suggestedFix", "owner"],
        "properties": {
          "caseId": { "type": "string" },
          "relatedCaseIds": { "type": ["array", "null"], "items": { "type": "string" } },
          "scenario": { "type": "string" },
          "endpoint": { "type": "string" },
          "category": { "enum": ["ENVIRONMENT", "AUTH_CONFIG", "CONTRACT_DRIFT", "SERVER_ERROR", "FUNCTIONAL_BUG", "TEST_DATA", "PERFORMANCE", "FLAKY", "TEST_DEFECT"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "signature": { "type": "string" },
          "summary": { "type": "string" },
          "probableCause": { "type": "string" },
          "suggestedFix": { "type": "string" },
          "owner": { "type": "string" },
          "newFailure": { "type": "boolean" },
          "firstFailedRun": { "type": "string" },
          "history": { "type": "array", "items": { "type": "string" } },
          "evidenceRef": { "type": "string" },
          "curl": { "type": ["string", "null"] },
          "bugTicket": { "type": "string" },
          "otherPossibleCauses": { "type": "array", "items": { "type": "string" } },
          "analysedBy": { "type": "string" }
        }
      }
    }
  }
}
